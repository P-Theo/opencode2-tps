    "./options.schema.json": "./options.schema.json"
  },
  "files": [
    "dist",
    "options.schema.json"
  ],
  "peerDependencies": {
    "@opentui/solid": ">=0.5.4",
    "solid-js": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "overrides": {
    "@opentui/solid": {
      "@babel/core": "^7.29.7"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@opencode/cli": "2.0.10",
    "@opencode/plugin": "2.0.10",
    "@opencode/theme": "2.0.10",
    "@opentui/core": "^0.5.10",
    "@opentui/solid": "^0.5.10",
    "@oxlint/plugins": "^1.78.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.0",
    "babel-preset-solid": "^1.9.12",
    "oxlint": "^1.78.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "check:compatibility": "node scripts/check-compatibility.mjs",
    "lint": "oxlint",
    "test": "bun test",
    "prepack": "npm run lint && npm run check && npm test && npm run build"
